<?xml version="1.0"?>
<!--
  Telescoping camera mast + shelf-inspection camera.

  Layout (heights are above the floor):

        [shelf camera]  <- 0.91 m retracted / 1.31 m extended, looks LEFT, tilted 15 deg down
             ||
             ||  mast_inner_link   (slides up/down = prismatic joint "mast_lift_joint")
            |  |
            |  |  mast_outer_link  (fixed tube, 0.30 m -> 0.80 m)
      ______|__|______
     |   base_link    |  (top at 0.30 m)
     o________________o

  Why these numbers (see retail_store world generator):
    * Shelf product levels span 0.12 m .. 1.65 m, shelf is 1.75 m tall.
    * Aisles are 2.68 m wide -> robot in the aisle centre is ~1.34 m from a shelf face.
    * A 90 deg HFOV, 4:3 camera at 1.31 m, pitched 15 deg down, sees from the floor
      up to ~1.84 m at 1.34 m distance (and 0.03..1.70 m at 1.0 m) -> every level in one frame.
    * Retracted (0.91 m) the top level is cut off - handy to demonstrate WHY the mast exists.

  The camera faces the robot's LEFT (+y). Driving up an aisle shows one shelf face,
  driving back down shows the other, so a simple there-and-back patrol covers both sides.
-->
<!-- NOTE - never write a colon followed by a space in comments in this file.
     ROS 2 launch parses robot_description as YAML first and crashes on it. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ===== Tunable mast parameters ===== -->
    <xacro:property name="mast_x"            value="-0.10"/>  <!-- mount point on base, behind centre (over the drive wheels = more stable) -->
    <xacro:property name="mast_outer_radius" value="0.035"/>
    <xacro:property name="mast_outer_length" value="0.50"/>
    <xacro:property name="mast_inner_radius" value="0.025"/>
    <xacro:property name="mast_inner_length" value="0.55"/>
    <xacro:property name="mast_inner_above"  value="0.08"/>   <!-- how far the inner tube sticks out when fully retracted -->
    <xacro:property name="mast_max_extension" value="0.40"/>  <!-- keeps 7 cm of overlap at full extension -->
    <xacro:property name="mast_speed"        value="0.10"/>   <!-- m/s, slow so the motion is visible in the demo -->
    <xacro:property name="mast_start_extension" value="0.40"/><!-- start fully extended = ready to inspect -->

    <!-- ===== Shelf camera parameters ===== -->
    <xacro:property name="shelf_cam_tilt"  value="${15.0 * pi / 180.0}"/>   <!-- positive pitch = look down -->
    <xacro:property name="shelf_cam_hfov"  value="${pi / 2.0}"/>            <!-- 90 deg -->
    <xacro:property name="shelf_cam_size_x" value="0.04"/>
    <xacro:property name="shelf_cam_size_y" value="0.10"/>
    <xacro:property name="shelf_cam_size_z" value="0.05"/>

    <!-- ===== Outer (fixed) tube ===== -->
    <link name="mast_outer_link">
        <visual>
            <geometry>
                <cylinder radius="${mast_outer_radius}" length="${mast_outer_length}"/>
            </geometry>
            <origin xyz="0 0 ${mast_outer_length / 2.0}" rpy="0 0 0"/>
            <material name="silver"/>
        </visual>
        <!-- mounting flange so it looks bolted to the base -->
        <visual>
            <geometry>
                <box size="0.14 0.14 0.02"/>
            </geometry>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${mast_outer_radius}" length="${mast_outer_length}"/>
            </geometry>
            <origin xyz="0 0 ${mast_outer_length / 2.0}" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertia m="0.4" r="${mast_outer_radius}" l="${mast_outer_length}"
                                o_xyz="0 0 ${mast_outer_length / 2.0}" o_rpy="0 0 0"/>
    </link>

    <joint name="base_mast_joint" type="fixed">
        <parent link="base_link"/>
        <child link="mast_outer_link"/>
        <origin xyz="${mast_x} 0 ${base_height}" rpy="0 0 0"/>
    </joint>

    <!-- ===== Inner (sliding) tube =====
         Its frame sits at the TOP of the outer tube; the tube body hangs down inside
         the outer tube. When the joint extends, the whole frame moves up. -->
    <link name="mast_inner_link">
        <visual>
            <geometry>
                <cylinder radius="${mast_inner_radius}" length="${mast_inner_length}"/>
            </geometry>
            <origin xyz="0 0 ${mast_inner_above - mast_inner_length / 2.0}" rpy="0 0 0"/>
            <material name="silver"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${mast_inner_radius}" length="${mast_inner_length}"/>
            </geometry>
            <origin xyz="0 0 ${mast_inner_above - mast_inner_length / 2.0}" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertia m="0.2" r="${mast_inner_radius}" l="${mast_inner_length}"
                                o_xyz="0 0 ${mast_inner_above - mast_inner_length / 2.0}" o_rpy="0 0 0"/>
    </link>

    <!-- PRISMATIC = sliding joint (moves in a straight line instead of rotating).
         lower/upper are metres of travel; velocity limits how fast Gazebo moves it. -->
    <joint name="mast_lift_joint" type="prismatic">
        <parent link="mast_outer_link"/>
        <child link="mast_inner_link"/>
        <origin xyz="0 0 ${mast_outer_length}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="${mast_max_extension}" effort="100.0" velocity="${mast_speed}"/>
        <dynamics damping="1.0" friction="0.0"/>
    </joint>

    <!-- ===== Shelf camera on top of the mast ===== -->
    <link name="shelf_camera_link">
        <visual>
            <geometry>
                <box size="${shelf_cam_size_x} ${shelf_cam_size_y} ${shelf_cam_size_z}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <!-- small lens so you can see which way it points in RViz/Gazebo -->
        <visual>
            <geometry>
                <cylinder radius="0.015" length="0.02"/>
            </geometry>
            <origin xyz="${shelf_cam_size_x / 2.0 + 0.01} 0 0" rpy="0 ${pi / 2.0} 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="${shelf_cam_size_x} ${shelf_cam_size_y} ${shelf_cam_size_z}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="0.1" x="${shelf_cam_size_x}" y="${shelf_cam_size_y}" z="${shelf_cam_size_z}"
                           o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <!-- rpy = (roll, pitch, yaw) -> pitch down by the tilt, then yaw +90 deg to face the robot's left -->
    <joint name="mast_camera_joint" type="fixed">
        <parent link="mast_inner_link"/>
        <child link="shelf_camera_link"/>
        <origin xyz="0 0 ${mast_inner_above + shelf_cam_size_z / 2.0 + 0.005}" rpy="0 ${shelf_cam_tilt} ${pi / 2.0}"/>
    </joint>

    <!-- Optical frame - ROS image convention is z forward, x right, y down
         (same trick as the front camera in camera.xacro) -->
    <link name="shelf_camera_link_optical"/>
    <joint name="shelf_camera_optical_joint" type="fixed">
        <parent link="shelf_camera_link"/>
        <child link="shelf_camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
    </joint>

    <!-- ===== Gazebo - shelf camera sensor ===== -->
    <gazebo reference="shelf_camera_link">
        <sensor name="shelf_camera" type="camera">
            <camera>
                <horizontal_fov>${shelf_cam_hfov}</horizontal_fov>
                <image>
                    <width>1024</width>
                    <height>768</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>10</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.005</stddev>
                </noise>
                <optical_frame_id>shelf_camera_link_optical</optical_frame_id>
                <camera_info_topic>shelf_camera/camera_info</camera_info_topic>
            </camera>
            <always_on>1</always_on>
            <update_rate>10</update_rate>
            <visualize>true</visualize>
            <topic>shelf_camera/image_raw</topic>
        </sensor>
    </gazebo>

    <!-- ===== Gazebo - mast motor =====
         JointPositionController listens on /mast/height_cmd (gz.msgs.Double, metres of
         extension 0.0 .. 0.40) and drives the joint there with a PID controller.
         (use_velocity_commands mode was tried but does not move the joint in gz-sim 8.15.) -->
    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>mast_lift_joint</joint_name>
            <topic>/mast/height_cmd</topic>
            <!-- PID gains - output is a FORCE (N) on the joint.
                 P pulls toward the target, D damps oscillation, I cancels the
                 steady pull of gravity (~3 N for the 0.3 kg tube + camera).
                 Slide speed is capped by the joint's velocity limit (mast_speed).
                 Tested on Gazebo Harmonic 8.15 -> ~1 cm overshoot, settles in a few s. -->
            <p_gain>600</p_gain>
            <i_gain>100</i_gain>
            <d_gain>80</d_gain>
            <i_max>10</i_max>
            <i_min>-10</i_min>
            <cmd_max>60</cmd_max>
            <cmd_min>-60</cmd_min>
            <initial_position>${mast_start_extension}</initial_position>
        </plugin>
    </gazebo>

</robot>
