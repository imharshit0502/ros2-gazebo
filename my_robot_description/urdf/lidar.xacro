<?xml version="1.0"?>
<!--
  2D LiDAR (laser scanner) used by SLAM and, later, Nav2.

  WHY A LIDAR?
    SLAM Toolbox builds the 2D occupancy map from laser scans. It matches each new
    scan against the map built so far to work out where the robot is. Cameras
    alone cannot do that in this package, so the robot needs a planar laser.

  WHERE / HOW
    * Mounted on the FRONT of the base deck (x = +0.20 m), beam plane about 0.34 m
      above the floor. At that height the beam hits shelf bases, products on the
      lowest levels, checkout counters and walls, which is what the map needs.
    * 270 deg field of view facing forward. The telescoping mast stands 0.30 m
      behind the scanner and would shadow a slice of a 360 deg scan, so the rear
      90 deg are left out. Real retail robots often use front 270 deg scanners too.
    * gz sensor type "gpu_lidar" is rendered by the Sensors system (ogre2) that the
      retail_store world already loads for the cameras.
    * gz_frame_id makes the ROS LaserScan header say "lidar_link", so the scan
      lines up with the TF tree published by robot_state_publisher.
-->
<!-- NOTE - never write a colon followed by a space in comments in this file.
     ROS 2 launch parses robot_description as YAML first and crashes on it. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="lidar_x"      value="0.20"/>
    <xacro:property name="lidar_radius" value="0.04"/>
    <xacro:property name="lidar_length" value="0.04"/>
    <xacro:property name="lidar_fov"    value="${270.0 * pi / 180.0}"/>

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:cylinder_inertia m="0.15" r="${lidar_radius}" l="${lidar_length}"
                                o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="${lidar_x} 0 ${base_height + lidar_length / 2.0}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
            <topic>scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <update_rate>10</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>541</samples>   <!-- 0.5 deg resolution -->
                        <resolution>1</resolution>
                        <min_angle>${-lidar_fov / 2.0}</min_angle>
                        <max_angle>${lidar_fov / 2.0}</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>20.0</max>     <!-- store is 18 x 18 m -->
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>  <!-- 1 cm, typical for a cheap 2D scanner -->
                </noise>
            </lidar>
        </sensor>
    </gazebo>
</robot>
