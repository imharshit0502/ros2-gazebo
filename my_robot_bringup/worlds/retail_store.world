<?xml version="1.0" ?>
<!--
  RETAIL STORE GAZEBO WORLD
  ============================================================
  Author : Harshit Jain — IIT Mandi Ph.D. / AMR Coursework
  Purpose: Simulate a retail store for AMR path planning,
           shelf-void CV training, and CPS research.

  STORE LAYOUT (top-down, all units in metres):
  ┌─────────────────────────────────────────────────────────┐  y=+8
  │  BACK STORAGE AREA (open)                              │
  │  ┌────┐  ┌────┐    ┌────┐  ┌────┐    ┌────┐  ┌────┐  │  y=+6.5
  │  │ W  │  │ W  │    │ C  │  │ C  │    │ E  │  │ E  │  │
  │  │ L  │  │ R  │    │ L  │  │ R  │    │ L  │  │ R  │  │  NORTH
  │  │ N  │  │ N  │    │ N  │  │ N  │    │ N  │  │ N  │  │  SHELF
  │  │    │  │    │    │    │  │    │    │    │  │    │  │  SEGMENTS
  │  └────┘  └────┘    └────┘  └────┘    └────┘  └────┘  │  y=+1.0
  │  ─── ─── ─── ─── CROSS-AISLE (1m) ─── ─── ─── ─── ─  │  y=[0,1]
  │  ┌────┐  ┌────┐    ┌────┐  ┌────┐    ┌────┐  ┌────┐  │  y= 0
  │  │ W  │  │ W  │    │ C  │  │ C  │    │ E  │  │ E  │  │
  │  │ L  │  │ R  │    │ L  │  │ R  │    │ L  │  │ R  │  │  SOUTH
  │  │ S  │  │ S  │    │ S  │  │ S  │    │ S  │  │ S  │  │  SHELF
  │  │    │  │    │    │    │  │    │    │    │  │    │  │  SEGMENTS
  │  └────┘  └────┘    └────┘  └────┘    └────┘  └────┘  │  y=-4.0
  │                                                       │
  │   [CHECKOUT 1]              [CHECKOUT 2]              │  y=-6.0
  │                                                       │
  └────────────────────[ENTRY]────────────────────────────┘  y=-8
  x= -10            -1.75  +1.75                        +10

  AISLES (N-S, 1.4m wide each):
    West   : x ∈ [-7.9, -6.1]  (banks at x=-7.7 and x=-6.3)
    Center : x ∈ [-0.9, +0.9]  (banks at x=-0.7 and x=+0.7)
    East   : x ∈ [+6.1, +7.9]  (banks at x=+6.3 and x=+7.7)

  CROSS-CORRIDORS (E-W, ~5.2m wide each):
    Corridor 1: x ∈ [-6.1, -0.9]
    Corridor 2: x ∈ [+0.9, +6.1]

  SHELF SEGMENTS:
    South: y ∈ [-4.0,  0.0], center_y = -2.0, length = 4.0m
    North: y ∈ [+1.0, +6.5], center_y = +3.75, length = 5.5m
    Each bank: 0.4m(x) × length(y) × 1.8m(z)
    Shelf boards at world z = 0.4, 0.9, 1.4

  ROBOT SPAWN RECOMMENDATION:
    <pose>0 -7 0 0 0 1.5708</pose>  (facing north, near entry)

  CAMERA HEIGHTS FOR SHELF SCANNING:
    Bottom shelf : z = 0.3m
    Mid shelf    : z = 0.8m
    Top shelf    : z = 1.3m
  ============================================================
-->

<sdf version="1.6">
  <world name="retail_store">

    <!-- ══════════════════ PHYSICS ══════════════════ -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ══════════════════ SCENE ══════════════════ -->
    <scene>
      <ambient>0.6 0.6 0.65 1</ambient>
      <background>0.4 0.4 0.4 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ══════════════════ LIGHTING ══════════════════ -->
    <!-- Directional sun (angled, cast shadows for depth perception) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.1 0.05 -1.0</direction>
    </light>

    <!-- Ceiling point lights simulating 6 fluorescent panels (3×2 grid) -->
    <light name="ceiling_w_south" type="point">
      <pose>-6.5 -2.5 2.9 0 0 0</pose>
      <diffuse>1.0 1.0 0.98 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>12</range><constant>0.4</constant>
        <linear>0.04</linear><quadratic>0.002</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="ceiling_c_south" type="point">
      <pose>0 -2.5 2.9 0 0 0</pose>
      <diffuse>1.0 1.0 0.98 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>12</range><constant>0.4</constant>
        <linear>0.04</linear><quadratic>0.002</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="ceiling_e_south" type="point">
      <pose>6.5 -2.5 2.9 0 0 0</pose>
      <diffuse>1.0 1.0 0.98 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>12</range><constant>0.4</constant>
        <linear>0.04</linear><quadratic>0.002</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="ceiling_w_north" type="point">
      <pose>-6.5 4.0 2.9 0 0 0</pose>
      <diffuse>1.0 1.0 0.98 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>12</range><constant>0.4</constant>
        <linear>0.04</linear><quadratic>0.002</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="ceiling_c_north" type="point">
      <pose>0 4.0 2.9 0 0 0</pose>
      <diffuse>1.0 1.0 0.98 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>12</range><constant>0.4</constant>
        <linear>0.04</linear><quadratic>0.002</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="ceiling_e_north" type="point">
      <pose>6.5 4.0 2.9 0 0 0</pose>
      <diffuse>1.0 1.0 0.98 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>12</range><constant>0.4</constant>
        <linear>0.04</linear><quadratic>0.002</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ══════════════════ FLOOR ══════════════════ -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 16</size></plane>
          </geometry>
          <material>
            <ambient>0.82 0.82 0.82 1</ambient>
            <diffuse>0.82 0.82 0.82 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════ CEILING (no collision — allows top-down camera) ══════════════════ -->
    <model name="ceiling">
      <static>true</static>
      <pose>0 0 3.075 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>20.0 16.0 0.15</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════ OUTER WALLS (height=3m, thickness=0.15m) ══════════════════ -->
    <!-- Wall material: off-white -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 8.075 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>20.3 0.15 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>20.3 0.15 3.0</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>10.075 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.15 16.3 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.15 16.3 3.0</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-10.075 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.15 16.3 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.15 16.3 3.0</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall: left of entry gap  x ∈ [-10, -1.75] → center=-5.875, len=8.25 -->
    <model name="wall_south_left">
      <static>true</static>
      <pose>-5.875 -8.075 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>8.25 0.15 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>8.25 0.15 3.0</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall: right of entry gap  x ∈ [+1.75, +10] → center=+5.875, len=8.25 -->
    <model name="wall_south_right">
      <static>true</static>
      <pose>5.875 -8.075 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>8.25 0.15 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>8.25 0.15 3.0</size></box></geometry>
          <material><ambient>0.92 0.92 0.92 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Entry door pillars (grey, 3.5m gap at south centre) -->
    <model name="door_pillar_left">
      <static>true</static>
      <pose>-1.825 -8.075 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.15 0.15 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.15 0.15 3.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="door_pillar_right">
      <static>true</static>
      <pose>1.825 -8.075 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.15 0.15 3.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.15 0.15 3.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════════
         SHELF BANKS
         Dimensions per bank: 0.4m(x) × length(y) × 1.8m(z)
         Pose z-center = 0.9  (sits on floor 0.0 → top 1.8m)
         Material: MDF wood brown  rgba(0.55, 0.35, 0.10)
         Shelf boards (visual only): 3 boards per bank at local z = -0.5, 0.0, +0.5
           → world z ≈ 0.4, 0.9, 1.4
         Collision: single solid box per bank (sufficient for navigation)
    ══════════════════════════════════════════════════════════════════ -->

    <!-- ─── WEST AISLE  (x=-7.7 and x=-6.3, 1.4m aisle gap) ─── -->

    <model name="shelf_west_left_south">
      <static>true</static>
      <pose>-7.7 -2.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.4 4.0 1.8</size></box></geometry>
        </collision>
        <visual name="frame">
          <geometry><box><size>0.4 4.0 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.10 1</ambient><diffuse>0.55 0.35 0.10 1</diffuse></material>
        </visual>
        <visual name="board1">
          <pose>0 0 -0.5 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board2">
          <pose>0 0 0.0 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board3">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_west_right_south">
      <static>true</static>
      <pose>-6.3 -2.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.4 4.0 1.8</size></box></geometry>
        </collision>
        <visual name="frame">
          <geometry><box><size>0.4 4.0 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.10 1</ambient><diffuse>0.55 0.35 0.10 1</diffuse></material>
        </visual>
        <visual name="board1">
          <pose>0 0 -0.5 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board2">
          <pose>0 0 0.0 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board3">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_west_left_north">
      <static>true</static>
      <pose>-7.7 3.75 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.4 5.5 1.8</size></box></geometry>
        </collision>
        <visual name="frame">
          <geometry><box><size>0.4 5.5 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.10 1</ambient><diffuse>0.55 0.35 0.10 1</diffuse></material>
        </visual>
        <visual name="board1">
          <pose>0 0 -0.5 0 0 0</pose>
          <geometry><box><size>0.42 5.52 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board2">
          <pose>0 0 0.0 0 0 0</pose>
          <geometry><box><size>0.42 5.52 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board3">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.42 5.52 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_west_right_north">
      <static>true</static>
      <pose>-6.3 3.75 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.4 5.5 1.8</size></box></geometry>
        </collision>
        <visual name="frame">
          <geometry><box><size>0.4 5.5 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.10 1</ambient><diffuse>0.55 0.35 0.10 1</diffuse></material>
        </visual>
        <visual name="board1">
          <pose>0 0 -0.5 0 0 0</pose>
          <geometry><box><size>0.42 5.52 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board2">
          <pose>0 0 0.0 0 0 0</pose>
          <geometry><box><size>0.42 5.52 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board3">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.42 5.52 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ─── CENTER AISLE  (x=-0.7 and x=+0.7, 1.4m aisle gap) ─── -->

    <model name="shelf_center_left_south">
      <static>true</static>
      <pose>-0.7 -2.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.4 4.0 1.8</size></box></geometry>
        </collision>
        <visual name="frame">
          <geometry><box><size>0.4 4.0 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.10 1</ambient><diffuse>0.55 0.35 0.10 1</diffuse></material>
        </visual>
        <visual name="board1">
          <pose>0 0 -0.5 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board2">
          <pose>0 0 0.0 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board3">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_center_right_south">
      <static>true</static>
      <pose>0.7 -2.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.4 4.0 1.8</size></box></geometry>
        </collision>
        <visual name="frame">
          <geometry><box><size>0.4 4.0 1.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.10 1</ambient><diffuse>0.55 0.35 0.10 1</diffuse></material>
        </visual>
        <visual name="board1">
          <pose>0 0 -0.5 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board2">
          <pose>0 0 0.0 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
        <visual name="board3">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.42 4.02 0.03</size></box></geometry>
          <material><ambient>0.65 0.42 0.12 1</ambient><diffuse>0.65 0.42 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shelf_center_left_north">
      <static>true</static>
      <pose>-0.7 3.75 0.9 0 0 0</pose>
